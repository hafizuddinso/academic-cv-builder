# Supabase public project config. RLS MUST be enabled in the database.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional canonical URL after Vercel deployment. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-side AI. These MUST NEVER be NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Only this authenticated user may use your paid AI API key.
AI_ALLOWED_EMAIL=
